{
  "name": "wwm-monitor",
  "version": "1.0.0",
  "description": "WWM Ping Monitor",
  "author": "Onyx Digital",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-python": "pyinstaller backend.spec --onefile --noconsole --distpath ./dist-python/",
    "build-all": "npm run build-python && electron-builder --win --x64",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.onyx.wwm-monitor",
    "productName": "WWM Monitor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WWM Monitor"
    },
    "extraResources": [
      {
        "from": "dist/backend.exe",
        "to": "backend.exe"
      },
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  }
}
